# copy to .env and fill in. .env is not committed

# NWS User-Agent, NWS requires contact info
RIDGECAST_USER_AGENT="(RidgeCast, contact@example.com)"

# Database. a MongoDB on another machine, or in another container, must be
# reached over TLS: add tls=true or use a mongodb+srv:// URI, or the server
# won't start. only localhost, 127.x.x.x, ::1, and Unix sockets may go without
DATABASE_URL=mongodb://127.0.0.1:27017
RIDGECAST_DB=ridgecast

# required: the secret phone numbers are hashed with, so the database never
# holds a number. at least 32 characters: openssl rand -hex 32. keep it apart
# from the database and its backups. changing it resends the opt-in message once
USER_NUMBERS_KEY=

# required: the contact address in the help message, which is also the opt-in
# message. toll-free verification requires it. at most 93 characters
SUPPORT_EMAIL=support@example.com

# SMS provider: local or telnyx. required, no default.
# local prints replies instead of sending them and adds POST /dev/sms for
# sending texts over HTTP. use it for development, or a staging server with its
# own database, never a server whose database also serves real users
SMS_PROVIDER=local

# required with SMS_PROVIDER=telnyx, both from the Telnyx portal: the API key
# messages are sent with, and the public key webhook signatures are checked
# against (base64). set the messaging profile's webhook URL to
# https://<your server>/webhooks/telnyx
# TELNYX_API_KEY=
# TELNYX_PUBLIC_KEY=

# SMS numbers, in E.164 format. read at startup: the server stops if
# SMS_NUMBER is missing or either number is invalid or they're the same
# required: the number users text, toll-free or a regular number
SMS_NUMBER=+18005550100
# optional: a second number for users outside the US and Canada, who can't
# text toll-free numbers. leave it unset to run with SMS_NUMBER only.
# setting it enables international support. international texts cost more
# to send, and a US long code needs A2P 10DLC registration with your provider.
# replies always come from the number the user texted
# SMS_INTERNATIONAL_NUMBER=+15415550100

# optional: the log filter. the default logs RidgeCast at info and its
# dependencies only at warn
# RUST_LOG=ridgecast=debug
