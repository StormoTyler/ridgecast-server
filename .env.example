# copy to .env and fill in. .env is not committed

# NWS User-Agent, NWS requires contact info
RIDGECAST_USER_AGENT="(RidgeCast, contact@example.com)"

# Database
DATABASE_URL=mongodb://127.0.0.1:27017
RIDGECAST_DB=ridgecast

# SMS numbers, in E.164 format. read at startup: the server stops if
# SMS_NUMBER is missing or either number is invalid or they're the same.
# no SMS provider sends from them yet
# required: the number users text, toll-free or a regular number
SMS_NUMBER=+18005550100
# optional: a second number for users outside the US and Canada, who can't
# text toll-free numbers. leave it unset to run with SMS_NUMBER only.
# setting it enables international support. international texts cost more
# to send, and a US long code needs A2P 10DLC registration with your provider.
# replies always come from the number the user texted
# SMS_INTERNATIONAL_NUMBER=+15415550100
